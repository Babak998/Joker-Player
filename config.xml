<?xml version="1.0" encoding="UTF-8"?>
<widget id="com.joker.player" version="4.7.1" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android">
  <name>Joker Player</name>
  <description>Joker Player Android music player</description>
  <content src="index.html" />
  <access origin="*" />
  <allow-navigation href="*" />
  <preference name="android-minSdkVersion" value="24" />
  <preference name="android-targetSdkVersion" value="36" />
  <preference name="Fullscreen" value="false" />
  <preference name="DisallowOverscroll" value="true" />
  <preference name="BackupWebStorage" value="none" />
  <plugin name="cordova-plugin-device" spec="3.0.0" />
  <plugin name="cordova-plugin-file" spec="8.1.3" />
  <plugin name="cordova-plugin-android-permissions" spec="1.1.5" />
  <plugin name="cordova-plugin-joker-native" spec="./native/cordova-plugin-joker-native" />
  <platform name="android">
    <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/uses-sdk">
      <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />
    </edit-config>
  </platform>
</widget>
